#!/bin/bash

NOTIFY="${QUACKO_NOTIFY:-$HOME/.claude/hooks/notify.sh}"

gh pr checks "$@" --watch --interval 15
rc=$?
[ "$rc" -ge 128 ] && exit "$rc"

view_args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -R | --repo)
      view_args+=("$1")
      [ $# -gt 1 ] && view_args+=("$2") && shift
      ;;
    --repo=*) view_args+=("$1") ;;
    -*) ;;
    *) view_args+=("$1") ;;
  esac
  shift
done

if [ "$rc" -eq 0 ]; then
  args=(--source ci --status ok --sticky --sound /System/Library/Sounds/Glass.aiff)
else
  args=(--source ci --status fail --sticky --sound /System/Library/Sounds/Basso.aiff)
fi

info=$(gh pr view ${view_args[@]+"${view_args[@]}"} --json number,title,url 2>/dev/null)
if [ -n "$info" ] && command -v jq >/dev/null; then
  number=$(printf '%s' "$info" | jq -r '.number // empty')
  title=$(printf '%s' "$info" | jq -r '.title // empty')
  url=$(printf '%s' "$info" | jq -r '.url // empty')
  repo=$(printf '%s' "$url" | sed -nE 's#^https?://[^/]+/([^/]+/[^/]+)/pull/[0-9]+.*#\1#p')
  [ -n "$number" ] && args+=(--title "PR #$number")
  [ -n "$title" ] && args+=(--message "$title")
  [ -n "$repo" ] && args+=(--project "$repo${number:+#$number}")
  [ -n "$url" ] && args+=(--url "$url")
fi

[ -x "$NOTIFY" ] && "$NOTIFY" "${args[@]}" </dev/null
exit "$rc"
